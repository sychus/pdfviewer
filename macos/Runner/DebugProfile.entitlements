<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Required for the file picker: the sandbox blocks access to any file the
	     user chooses unless the app declares this. Read-only is the correct
	     level for a viewer — we never write back to the PDF. Reading positions
	     are stored in the app's own container, which needs no entitlement. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
